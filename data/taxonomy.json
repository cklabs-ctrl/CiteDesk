  "priorities": [
    {
      "level": "P1 - Critical",
      "description": "Complete service outage affecting multiple users or business-critical revenue/production process."
    },
    {
      "level": "P2 - High",
      "description": "High business impact or single customer-critical blocker with no immediate workaround."
    },
    {
      "level": "P3 - Medium",
      "description": "Operational issue with existing workaround or single non-critical user workflow degradation."
    },
    {
      "level": "P4 - Low",
      "description": "Minor inquiry, cosmetic issue, or low-urgency service request."
    }
